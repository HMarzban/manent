<FinalDraft DocumentType="Script" Template="No" Version="5">
  <Content>
    <Paragraph Number="1" Type="Scene Heading">
      <Text>INT. LAMP ROOM - NIGHT</Text>
    </Paragraph>
    <Paragraph Number="2" Type="Scene Heading">
      <Text>EXT. GALLERY - NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="0">Wind. </Text>
      <Text RevisionID="1">The glass hums.</Text>
    </Paragraph>
    <Paragraph Type="General">
      <DualDialogue>
        <Paragraph Type="Character">
          <Text>DANA</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>Hold it.</Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text>SAM</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>I have it now.</Text>
        </Paragraph>
      </DualDialogue>
      <Text></Text>
    </Paragraph>
    <Paragraph Number="3" Type="Scene Heading">
      <Text>INT. STAIRS - NIGHT</Text>
    </Paragraph>
    <Paragraph Number="3A" Type="Scene Heading">
      <Text>INT. STAIRS, LANDING - NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text RevisionID="2">Salt on every step.</Text>
    </Paragraph>
    <Paragraph Number="4" Type="Scene Heading">
      <Text>EXT. ROCKS - DAWN</Text>
    </Paragraph>
  </Content>
