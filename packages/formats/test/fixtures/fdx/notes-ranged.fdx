<FinalDraft DocumentType="Script" Template="No" Version="6">
  <Content>
    <Paragraph Type="Scene Heading">
      <Text>EXT. GALLERY - NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Wind on the rail. The glass hums.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Sam climbs.</Text>
    </Paragraph>
  </Content>
  <ScriptNotes>
    <ScriptNote ID="7" Range="49,53" Type="Note" WriterName="Priya Nair">
      <Paragraph>
        <Text>Louder than the wind.</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote ID="8" Range="39,59" WriterName="Sam Okafor">
      <Paragraph>
        <Text>This runs on to the climb.</Text>
      </Paragraph>
    </ScriptNote>
  </ScriptNotes>
</FinalDraft>
