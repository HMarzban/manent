{
  "name": "manent",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "bench",
      "e2e",
      "tools"
    ],
    "catalog": {
      "typescript": "7.0.2",
      "@types/bun": "1.4.4",
      "prosemirror-model": "1.25.13",
      "prosemirror-state": "1.4.4",
      "prosemirror-view": "1.42.9",
      "prosemirror-transform": "1.12.5",
      "prosemirror-keymap": "1.2.3",
      "prosemirror-commands": "1.7.2",
      "prosemirror-changeset": "2.4.6",
      "yjs": "13.6.33",
      "y-prosemirror": "1.3.7",
      "y-protocols": "1.0.7",
      "lib0": "0.2.120",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@base-ui/react": "1.9.0",
      "class-variance-authority": "0.7.1",
      "cn": "0.5.2",
      "tailwindcss": "4.1.14",
      "tw-animate-css": "1.4.0",
      "bun-plugin-tailwind": "0.1.2",
      "zustand": "5.1.0",
      "@tanstack/react-router": "1.170.46",
      "@tanstack/react-query": "5.107.1",
      "@tanstack/react-virtual": "3.14.26",
      "@tanstack/react-hotkeys": "0.25.1",
      "lucide-react": "1.73.0",
      "serwist": "9.5.13",
      "pdfkit": "0.20.2",
      "@types/pdfkit": "0.17.7",
      "fontkit": "2.0.4",
      "@types/fontkit": "2.0.9",
      "pdfjs-dist": "6.5.438",
      "@fontsource/courier-prime": "5.3.0",
      "@fontsource-variable/inter": "5.3.0",
      "fast-check": "4.10.2",
      "fake-indexeddb": "6.2.8",
      "@happy-dom/global-registrator": "21.0.4",
      "@playwright/test": "1.65.1",
      "@axe-core/playwright": "4.14.0",
      "oxlint": "1.93.0",
      "electrobun": "2.0.6"
    }
  },
  "scripts": {
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run tracked && bun run boundaries && bun run records && bun run tour && bun run test:unit",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "bun check",
    "lint": "oxlint --deny-warnings packages apps bench e2e tools",
    "tracked": "bun tools/check-tracked.ts",
    "boundaries": "bun tools/check-boundaries.ts",
    "records": "bun tools/check-records.ts",
    "tour": "bun tools/check-tour.ts",
    "test:unit": "bun test --isolate ./packages ./apps ./tools ./bench",
    "test:e2e": "MANENT_FLAVOUR=test bun run build:web && MANENT_FLAVOUR=test bun run --filter @manent/e2e test",
    "test:clone": "bun test ./e2e/clone",
    "test": "bun run test:unit && bun run test:e2e && bun run test:clone",
    "build:web": "bun apps/web/build.ts",
    "bench": "bun bench/run.ts",
    "demo": "bun tools/demo/cli.ts demo",
    "desktop": "bun tools/demo/cli.ts desktop",
    "reset": "bun tools/demo/cli.ts reset",
    "stop": "bun tools/demo/cli.ts stop",
    "check:stock": "bun tools/check-stock.ts",
    "test:durability": "MANENT_KILLS=200 bun test ./packages/testkit/test/kill-recover.test.ts",
    "test:offline": "MANENT_FLAVOUR=test bun run build:web && MANENT_FLAVOUR=test bun run --filter @manent/e2e test offline",
    "desktop:build": "bun tools/desktop/build.ts",
    "desktop:check": "bun check -p apps/desktop/tsconfig.shell.json",
    "desktop:smoke": "bun tools/desktop/smoke.ts",
    "desktop:headless": "bun tools/desktop/headless.ts",
    "seed:check": "bun tools/demo/seed-check.ts",
    "test:demo": "bun run --filter @manent/e2e test:tour",
    "bench:seed": "bun bench/run.ts demo"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/bun": "catalog:",
    "oxlint": "catalog:"
  }
}
