{
  "name": "manent",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "bench",
      "e2e",
      "tools"
    ],
    "catalog": {
      "typescript": "^7",
      "@types/bun": "1.4.4",
      "prosemirror-model": "1.25.13",
      "prosemirror-state": "1.4.4",
      "prosemirror-view": "1.42.9",
      "prosemirror-transform": "1.12.5",
      "prosemirror-keymap": "1.2.3",
      "prosemirror-commands": "1.7.2",
      "prosemirror-inputrules": "1.6.0",
      "prosemirror-gapcursor": "1.4.1",
      "prosemirror-search": "1.1.1",
      "prosemirror-changeset": "2.4.6",
      "yjs": "13.6.33",
      "y-prosemirror": "1.3.7",
      "y-protocols": "1.0.7",
      "lib0": "0.2.120",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@base-ui/react": "1.9.0",
      "tailwindcss": "4.3.5",
      "bun-plugin-tailwind": "0.1.2",
      "zustand": "5.1.0",
      "@tanstack/react-router": "1.170.46",
      "@tanstack/react-query": "5.107.1",
      "@tanstack/react-virtual": "3.14.26",
      "@tanstack/react-table": "9.3.1",
      "@tanstack/react-form": "1.33.5",
      "@tanstack/react-hotkeys": "0.27.0",
      "@tanstack/react-pacer": "0.24.1",
      "@dnd-kit/react": "0.5.3",
      "lucide-react": "^1",
      "sonner": "2.0.8",
      "react-resizable-panels": "4.24.0",
      "serwist": "9.5.14",
      "pdfkit": "0.20.2",
      "inkjs": "2.4.0",
      "@fontsource/courier-prime": "5.3.0",
      "fast-check": "4.10.2",
      "@playwright/test": "1.65.1",
      "tinybench": "6.2.3",
      "oxlint": "1.93.0",
      "electrobun": "2.0.6",
      "electron": "45.3.3"
    }
  },
  "scripts": {
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run tracked && bun run boundaries && bun run test:unit",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "bun check",
    "lint": "oxlint --deny-warnings packages apps bench e2e tools",
    "tracked": "bun tools/check-tracked.ts",
    "boundaries": "bun tools/check-boundaries.ts",
    "test:unit": "bun test ./packages ./apps ./tools ./bench",
    "test:e2e": "bun run build:web && bun run --filter @manent/e2e test",
    "test:clone": "bun test ./e2e/clone",
    "test": "bun run test:unit && bun run test:e2e && bun run test:clone",
    "build:web": "bun apps/web/build.ts",
    "bench": "bun bench/run.ts",
    "demo": "bun tools/demo/cli.ts demo",
    "desktop": "bun tools/demo/cli.ts desktop",
    "reset": "bun tools/demo/cli.ts reset",
    "stop": "bun tools/demo/cli.ts stop"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/bun": "catalog:",
    "oxlint": "catalog:"
  }
}
