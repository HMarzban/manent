  "shadcnProbeSteps": {
    "shadcn": "4.23.0",
    "commands": [
      {
        "cwd": "shadcn-probe",
        "run": "bun add --dev --exact shadcn@4.23.0",
        "outcome": "installed shadcn@4.23.0"
      },
      {
        "cwd": "shadcn-probe",
        "run": "bunx shadcn init -t vite -b base -n app -y --no-monorepo",
        "outcome": "stopped at the prompt Which preset would you like to use? (no flag in the command answers it)"
      },
      {
        "cwd": "shadcn-probe",
        "run": "bunx shadcn init -t vite -b base -p nova -n app -y --no-monorepo",
        "outcome": "exit 1: We could not detect a supported framework (a package.json in the working directory makes the CLI initialise that directory instead of creating a project)"
      },
      {
        "cwd": "shadcn-probe",
        "run": "mkdir work && bunx shadcn init -t vite -b base -p nova -n app -y --no-monorepo -c work",
        "outcome": "created work/app, a Vite project with its own git repository, and installed its dependencies"
      },
      {
        "cwd": "shadcn-probe",
        "run": "mv work/app app && rmdir work && rm -rf app/.git",
        "outcome": "the project is shadcn-probe/app, with no nested repository"
      },
      {
        "cwd": "shadcn-probe",
        "run": "cp bunfig.toml app/ && rm -rf app/node_modules app/bun.lock",
        "outcome": "the release-age rule now applies inside app"
      },
      {
        "cwd": "shadcn-probe/app",
        "run": "bun install",
        "outcome": "exit 1: No version matching \"^1.75.0\" found for specifier \"lucide-react\" (blocked by minimum-release-age: 259200 seconds)"
      },
      {
        "cwd": "shadcn-probe/app",
        "run": "bun add --exact lucide-react@1.73.0",
        "outcome": "installed; 1.73.0 is the newest release the rule accepts (1.74.0 and 1.75.0 are younger than three days)"
      },
      {
        "cwd": "shadcn-probe/app",
        "run": "bunx shadcn add dialog popover combobox autocomplete -y",
        "outcome": "exit 1: The item at https://ui.shadcn.com/r/styles/base-nova/autocomplete.json was not found"
      },
      {
        "cwd": "shadcn-probe/app",
        "run": "bunx shadcn add dialog popover combobox -y",
        "outcome": "created popover, input, textarea, dialog, input-group and combobox; no new package installed"
      },
      {
        "cwd": ".",
        "run": "bun scripts/primitive-check.ts shadcn-probe/app",
        "outcome": "offenders: []"
      }
    ],
    "versionsChangedByTheRule": [
