{
  "id": "/",
  "name": "Manent",
  "short_name": "Manent",
  "description": "Screenwriting and script app that works offline with identical pages everywhere.",
  "lang": "en-GB",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f6f4f0",
  "theme_color": "#f6f4f0",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Library",
      "url": "/"
    },
    {
      "name": "Preferences",
      "url": "/preferences/writing"
    }
  ],
  "file_handlers": [
    {
      "action": "/?launch=file",
      "accept": {
        "application/xml": [".fdx"],
        "text/plain": [".fountain", ".ink"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  }
}
